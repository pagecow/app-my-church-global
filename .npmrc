# expo-router depends on react-native-drawer-layout, whose required peers are
# react-native-reanimated and react-native-gesture-handler. This app has no
# drawer and has never shipped those libraries; without this line npm installs
# their newest versions (not the ones the Expo SDK is tested with) and they get
# compiled into the app. To add them on purpose: delete this file and run
# `npx expo install react-native-reanimated react-native-worklets react-native-gesture-handler`.
legacy-peer-deps=true
