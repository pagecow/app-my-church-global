# Expo SDK 56 made expo/fetch the global fetch. This keeps React Native's own
# fetch, the one every released version of this app has used. Photo and video
# uploads read the picked file with fetch(uri).blob() and PUT that blob; with
# expo/fetch the whole file is copied through JavaScript memory several times.
# Remove this line only after uploads (a long video too) are tested on real phones.
EXPO_PUBLIC_USE_RN_FETCH=1
